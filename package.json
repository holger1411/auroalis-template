{
  "name": "auroalis-template",
  "version": "1.0.2",
  "private": true,
  "description": "Auroalis — a clean, content-rich HTML landing page + article template built with Tailwind CSS 4",
  "scripts": {
    "dev": "concurrently \"npm run watch\" \"npm run serve\"",
    "build": "npx @tailwindcss/cli -i css/input.css -o css/styles.css --minify",
    "watch": "npx @tailwindcss/cli -i css/input.css -o css/styles.css --watch",
    "serve": "browser-sync start --server --files \"*.html, css/styles.css, js/*.js\" --no-notify"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "browser-sync": "^3.0.3",
    "concurrently": "^9.1.2"
  }
}
